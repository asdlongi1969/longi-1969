---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import SocialPost from "../components/SocialPost.astro";
import Spaccatura from "../components/Spaccatura.astro";
import SponsorStrip from "../components/SponsorStrip.astro";
import NextMatch from "../components/NextMatch.astro";
import DirettaLive from "../components/DirettaLive.astro";
import Debutto from "../components/Debutto.astro";
import Rinascita from "../components/Rinascita.astro";
import TabelloneGirone from "../components/TabelloneGirone.astro";
import MuroRosa from "../components/MuroRosa.astro";
import Formazione from "../components/Formazione.astro";
import PlayerDialog from "../components/PlayerDialog.astro";
import { ordinaRosa } from "../lib/rosa";
import { componiFormazione } from "../lib/formazione";
import datiFormazione from "../data/formazione.json";

const social = (await getCollection("social"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const rosa = ordinaRosa(await getCollection("giocatori"));
// Formazione dal pannello; se non e' completa (11 giocatori diversi) torna il muro della rosa.
const formazione = componiFormazione(datiFormazione, rosa.map((g) => g.data));
---
{/* Ordine diverso dal sito gemello: dopo l'hero vengono SUBITO le partite
    (quello che il tifoso cerca la domenica), poi i post social a mosaico. */}
<Base title="Squadra di calcio di Longi (ME)" description="Sito ufficiale dell'ASD Longi 1969, la squadra di calcio di Longi (Messina) nel girone C di Seconda Categoria: formazione, rosa, classifica, storia e contatti.">
  <main id="main" tabindex="-1">
    <Hero />

    <DirettaLive />

    <Debutto />

    <NextMatch />

    <Spaccatura />

    {social.length > 0 && (
      <section class="social-section" aria-labelledby="social-title">
        <div class="section-inner">
          <h2 id="social-title" class="font-display">Dai social</h2>
          <div class="social-grid">
            {social.map((p) => <SocialPost link={p.data.link} date={p.data.date} />)}
          </div>
          <p class="all-news"><a href="/social">Tutti i post</a></p>
        </div>
      </section>
    )}

    <Rinascita />

    <Spaccatura inverti />

    <TabelloneGirone />

    {formazione ? (
      <Formazione formazione={formazione} />
    ) : rosa.length > 0 && (
      <section class="rosa-home" aria-labelledby="rosa-title">
        <div class="section-inner">
          <h2 id="rosa-title" class="font-display">La rosa</h2>
        </div>
        <MuroRosa players={rosa} />
        <div class="section-inner">
          <p class="all-news"><a href="/squadra">Tutta la squadra e lo staff</a></p>
        </div>
      </section>
    )}

    <Spaccatura />

    <SponsorStrip />
    <PlayerDialog />
  </main>
</Base>
<style>
  .social-section {
    padding: clamp(3rem, 8vw, 6rem) clamp(1rem, 4vw, 2.5rem) clamp(2rem, 6vw, 4rem);
  }
  .section-inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .rosa-home {
    padding: clamp(3rem, 8vw, 6rem) clamp(1rem, 4vw, 2.5rem) clamp(2rem, 6vw, 4rem);
  }
  .rosa-home h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0 0 0.5rem;
  }
  .social-section h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0 0 1.5rem;
  }
  /* Mosaico sfalsato: tre colonne che non si allineano mai, la centrale
     scende. Diverso dal gemello (prima notizia doppia su due colonne). */
  .social-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem 1.5rem;
  }
  @media (min-width: 720px) {
    .social-grid {
      grid-template-columns: repeat(3, 1fr);
      align-items: start;
    }
    /* nth-of-type e non nth-child: Astro mette lo <script> di SocialPost
       dentro la griglia, dopo la prima card, e falserebbe il conteggio. */
    .social-grid > :global(.social-card:nth-of-type(3n + 2)) {
      margin-top: clamp(1.5rem, 4vw, 3rem);
    }
  }
  /* Le tre card entrano una dopo l'altra col taglio obliquo dello scudo,
     legate allo scroll: lo sfalsamento e' dato da tre finestre diverse
     della stessa corsa. Si anima SOLO opacity e clip-path: il transform
     resta libero per il sollevamento su hover della card.
     SOLO proprieta' animation-* estese (vincolo del minificatore). */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .social-grid > :global(.social-card) {
        animation-name: post-entra;
        animation-duration: 1s;
        animation-fill-mode: both;
        animation-timing-function: var(--ease-out-quart);
        animation-timeline: view();
        animation-range: entry 0% entry 70%;
      }
      .social-grid > :global(.social-card:nth-of-type(2)) {
        animation-range: entry 15% entry 85%;
      }
      .social-grid > :global(.social-card:nth-of-type(3)) {
        animation-range: entry 30% entry 100%;
      }
    }
  }
  @keyframes post-entra {
    from {
      opacity: 0;
      clip-path: polygon(-5% -10%, 12% -10%, -8% 110%, -5% 110%);
    }
    to {
      opacity: 1;
      clip-path: polygon(-5% -10%, 130% -10%, 115% 110%, -5% 110%);
    }
  }
  /* Ripiego senza animation-timeline (script in Base.astro). */
  .social-grid > :global(.social-card.reveal-js) {
    opacity: 0;
    clip-path: polygon(-5% -10%, 12% -10%, -8% 110%, -5% 110%);
    transition: opacity 0.9s var(--ease-out-quart), clip-path 0.9s var(--ease-out-quart);
  }
  .social-grid > :global(.social-card:nth-of-type(2).reveal-js) { transition-delay: 0.12s; }
  .social-grid > :global(.social-card:nth-of-type(3).reveal-js) { transition-delay: 0.24s; }
  .social-grid > :global(.social-card.reveal-on) {
    opacity: 1;
    clip-path: polygon(-5% -10%, 130% -10%, 115% 110%, -5% 110%);
  }
  .all-news {
    margin: 1.5rem 0 0;
  }
  .all-news a {
    color: var(--oro);
    text-decoration: none;
  }
  .all-news a:hover,
  .all-news a:focus-visible {
    text-decoration: underline;
  }
</style>
