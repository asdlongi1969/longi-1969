---
import Base from "../layouts/Base.astro";
import societa from "../data/societa.json";
---
<Base title="Contatti" description="Contatti e form di contatto del Longi 1969">
  <main id="main" tabindex="-1">
    <section class="intro">
      <div class="inner">
        <h1 class="font-display">Contatti</h1>
        <p class="kicker">Scrivici per tesseramenti, collaborazioni o qualsiasi altra richiesta.</p>
      </div>
    </section>

    <!-- fascia decorativa omessa: nessuna fototeca ambiente per Longi -->

    <section class="contatti-section">
      <div class="inner grid">
        <form name="contatti" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="contact-form">
          <input type="hidden" name="form-name" value="contatti" />
          <p class="hidden-field">
            <label>
              Non compilare questo campo se sei umano
              <input name="bot-field" />
            </label>
          </p>

          <div class="field">
            <label for="nome">Nome e cognome</label>
            <input id="nome" name="nome" type="text" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" required autocomplete="email" />
          </div>
          <div class="field">
            <label for="messaggio">Messaggio</label>
            <textarea id="messaggio" name="messaggio" rows="6" required></textarea>
          </div>
          <button type="submit">Invia messaggio</button>
          <!-- Informativa nel punto in cui i dati vengono raccolti: e' quanto
               chiede l'articolo 13 del GDPR, non basta averla in fondo. -->
          <p class="form-privacy">
            I dati inseriti servono solo a rispondere e non vengono usati per altro.
            Leggi l'<a href="/privacy">informativa privacy</a>.
          </p>
        </form>

        <aside class="dati-societari">
          <h2 class="font-display">La società</h2>
          <p class="font-display club-name">{societa.denominazioneBreve}</p>
          <p>{societa.indirizzo || societa.comune}</p>
          {societa.campoNome ? (
            <p>Campo sportivo &quot;{societa.campoNome}&quot;</p>
          ) : (
            <p>Campo comunale di Longi (nome da confermare)</p>
          )}
          {societa.codiceFiscale && <p>Codice fiscale {societa.codiceFiscale}</p>}
          {societa.partitaIva && <p>P.IVA {societa.partitaIva}</p>}
          {societa.telefono && <p>Tel. {societa.telefono}</p>}
          {societa.email && <p><a href={`mailto:${societa.email}`}>{societa.email}</a></p>}
          {societa.pec && <p>PEC: {societa.pec}</p>}
          {!societa.telefono && !societa.email && (
            <p class="da-confermare">Recapiti in arrivo dalla società.</p>
          )}
          <p class="social-heading">Seguici</p>
          <ul class="social">
            {societa.instagram && <li><a href={societa.instagram} target="_blank" rel="noopener noreferrer">Instagram</a></li>}
            {societa.facebook && <li><a href={societa.facebook} target="_blank" rel="noopener noreferrer">Facebook</a></li>}
            {!societa.instagram && !societa.facebook && (
              <li class="da-confermare">Profili social in arrivo dalla società.</li>
            )}
          </ul>
        </aside>
      </div>
    </section>
  </main>
</Base>
<style>
  .inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .intro {
    padding: clamp(3rem, 8vw, 5rem) clamp(1rem, 4vw, 2.5rem) clamp(1.5rem, 4vw, 2.5rem);
  }
  .intro h1 {
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    margin: 0 0 0.5rem;
  }
  .kicker {
    color: var(--oro);
    max-width: 55ch;
  }
  .contatti-section {
    padding: clamp(1.5rem, 4vw, 2.5rem) clamp(1rem, 4vw, 2.5rem) clamp(3rem, 8vw, 6rem);
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 5vw, 3rem);
  }
  @media (min-width: 860px) {
    .grid {
      grid-template-columns: 3fr 2fr;
      align-items: start;
    }
  }
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .hidden-field {
    display: none;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .field label {
    font-weight: 700;
  }
  .field input,
  .field textarea {
    background: var(--surface);
    color: var(--text);
    border: 1px solid color-mix(in oklch, var(--text) 30%, transparent);
    border-radius: 2px;
    padding: 0.65rem 0.8rem;
    font: inherit;
  }
  .field input:focus-visible,
  .field textarea:focus-visible {
    border-color: var(--oro);
  }
  .field textarea {
    resize: vertical;
  }
  .form-privacy {
    margin: 0.9rem 0 0;
    font-size: 0.8rem;
    color: color-mix(in oklch, var(--text) 72%, transparent);
    max-width: 52ch;
  }
  .form-privacy a { color: var(--oro); }
  .da-confermare {
    color: var(--oro);
    font-size: 0.85rem;
    margin-top: 0.6rem;
  }
  .contact-form button {
    align-self: flex-start;
    padding: 0.8rem 2rem;
    background: var(--oro);
    color: var(--bg);
    border: none;
    font-family: var(--font-display);
    font-size: 1.05rem;
    cursor: pointer;
  }
  .contact-form button:hover,
  .contact-form button:focus-visible {
    background: color-mix(in oklch, var(--oro) 82%, var(--bg));
  }
  .dati-societari {
    background: var(--surface);
    padding: clamp(1.5rem, 4vw, 2rem);
  }
  .dati-societari h2 {
    font-size: 1.3rem;
    margin: 0 0 1rem;
  }
  .club-name {
    font-size: 1.1rem;
    margin: 0 0 0.4rem;
  }
  .dati-societari p {
    margin: 0.2rem 0;
  }
  .dati-societari p.social-heading {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 0.9rem;
    color: var(--oro);
    margin: 1.5rem 0 0.5rem;
  }
  .social {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .social a {
    color: var(--text);
  }
  .social a:hover,
  .social a:focus-visible {
    color: var(--oro);
  }
</style>
