---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import PlayerCard from "../components/PlayerCard.astro";
import MuroRosa from "../components/MuroRosa.astro";
import PlayerDialog from "../components/PlayerDialog.astro";
import StaffList from "../components/StaffList.astro";

import { RUOLI, ordinaRosa } from "../lib/rosa";

const ROLE_LABELS: Record<(typeof RUOLI)[number], string> = {
  Portiere: "Portieri",
  Difensore: "Difensori",
  Centrocampista: "Centrocampisti",
  Attaccante: "Attaccanti",
};

const giocatori = await getCollection("giocatori");
const gruppi = RUOLI.map((ruolo) => ({
  ruolo,
  label: ROLE_LABELS[ruolo],
  giocatori: giocatori
    .filter((g) => g.data.ruolo === ruolo)
    .sort((a, b) => (a.data.numero ?? 999) - (b.data.numero ?? 999)),
})).filter((g) => g.giocatori.length > 0);

const staff = (await getCollection("staff", (m) => m.data.sezione === "Staff tecnico")).sort(
  (a, b) => a.data.ordine - b.data.ordine || a.data.nome.localeCompare(b.data.nome, "it")
);

// Il muro rossoblu' mostra tutta la rosa in ordine di ruolo e numero: e' il
// colpo d'occhio. La griglia raggruppata sotto resta la consultazione vera.
const rosaOrdinata = ordinaRosa(giocatori);
---
<Base title="Squadra" description="Rosa e staff tecnico dell'ASD Longi 1969, squadra di calcio di Longi (ME), stagione 2026/27">
  <main id="main" tabindex="-1">
    <section class="intro">
      <div class="inner">
        <h1 class="font-display">Squadra</h1>
        <p class="kicker">Rosa e staff tecnico, stagione 2026/27</p>
      </div>
    </section>

    {rosaOrdinata.length > 0 && <MuroRosa players={rosaOrdinata} />}

    {gruppi.length > 0 ? (
      gruppi.map((gruppo, i) => (
        <section class="role-section">
          <div class="inner">
            <div class="role-heading">
              <span class="role-index font-display" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <h2 class="font-display">{gruppo.label}</h2>
            </div>
            <div class="roster-grid">
              {gruppo.giocatori.map((giocatore) => <PlayerCard player={giocatore} />)}
            </div>
          </div>
        </section>
      ))
    ) : (
      <section class="role-section">
        <div class="inner">
          <p>Rosa in aggiornamento.</p>
        </div>
      </section>
    )}

    {staff.length > 0 && (
      <section class="staff-section">
        <div class="inner">
          <h2 class="font-display">Staff</h2>
          <StaffList persone={staff} />
        </div>
      </section>
    )}
    <PlayerDialog />
  </main>
</Base>
<style>
  .inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .intro {
    padding: clamp(3rem, 8vw, 5rem) clamp(1rem, 4vw, 2.5rem) clamp(1.5rem, 4vw, 2.5rem);
  }
  .intro h1 {
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    margin: 0 0 0.5rem;
  }
  .kicker {
    color: var(--oro);
    max-width: 55ch;
  }
  .role-section {
    padding: clamp(1.5rem, 4vw, 2.5rem) clamp(1rem, 4vw, 2.5rem);
  }
  .role-section:nth-of-type(even) {
    background: var(--surface);
  }
  .role-heading {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }
  .role-index {
    color: var(--oro);
    font-size: 1.25rem;
  }
  .role-heading h2 {
    font-size: clamp(1.4rem, 3.5vw, 2rem);
    margin: 0;
  }
  .roster-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 1.25rem;
  }
  /* Telefono: due colonne fisse. La card orfana (unica del ruolo, o ultima
     dispari) prende tutta la riga e sta al centro, larga come una card:
     prima restava incollata a sinistra con la meta' destra vuota. */
  @media (max-width: 719px) {
    .roster-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .roster-grid > :global(.player-card:last-child:nth-child(odd)) {
      grid-column: 1 / -1;
      justify-self: center;
      width: min(100%, 220px);
    }
  }
  .staff-section {
    padding: clamp(2.5rem, 6vw, 4rem) clamp(1rem, 4vw, 2.5rem) clamp(3rem, 7vw, 5rem);
  }
  .staff-section h2 {
    font-size: clamp(1.4rem, 3.5vw, 2rem);
    margin: 0 0 1.5rem;
  }
</style>
