---
// Inno del Longi in sottofondo, con pulsante per fermarlo.
//
// I browser non lasciano partire l'audio da solo all'apertura di un sito:
// parte al primo tocco, clic o tasto del visitatore (se il browser lo permette
// anche prima, tanto meglio). Chi lo ferma non lo sente piu' ripartire da solo
// (scelta ricordata nel browser); cambiando pagina riprende dal punto in cui
// era. Il file sta sul sito stesso: nessun servizio esterno, nessun consenso.
// Su PC scorrere con la rotellina non conta come gesto: finche' l'inno aspetta
// un clic, il pulsante pulsa e dice "Clicca per l'inno" ("Tocca" sui telefoni).
// Mentre suona compare accanto il collegamento al brano su Spotify: e' un
// semplice link (niente riquadro di Spotify in pagina, quindi nessun dato
// parte finche' non lo si apre), e aprendolo l'inno del sito si ferma.
---
<audio data-inno src="/audio/inno-longi.mp3" preload="none" loop></audio>
<div class="inno-barra">
<button type="button" class="inno" data-inno-pulsante aria-pressed="false" aria-label="Fai partire l'inno del Longi">
  <svg class="icona-play" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5v14l11-7z" /></svg>
  <svg class="icona-stop" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="6" y="6" width="12" height="12" rx="1.5" /></svg>
  <span class="testo">Inno</span>
  <span class="invito"><span class="clic">Clicca</span><span class="tocco">Tocca</span> per l'inno</span>
</button>
<a
  class="spotify"
  href="https://open.spotify.com/track/6d2VIM1vC76WxvgwCbrKn4"
  target="_blank"
  rel="noopener noreferrer"
  data-inno-spotify
  hidden
>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="12" fill="#1ED760" />
    <path d="M6.3 9.2c3.8-1.1 8-.8 11.4 1.1M6.9 12.6c3.1-.9 6.5-.6 9.3 1M7.5 15.8c2.5-.7 5.1-.5 7.3.8" fill="none" stroke="#000" stroke-width="1.7" stroke-linecap="round" />
  </svg>
  <span>Ascoltalo su Spotify</span>
  <span class="visually-hidden">(si apre in una nuova scheda)</span>
</a>
</div>

<style>
  .inno-barra {
    position: fixed;
    left: 1rem;
    /* Sopra la barra dei cookie finche' e' aperta (vedi CookieNotice). */
    bottom: calc(1rem + var(--cookie-h, 0px) + var(--app-banner-h, 0px));
    z-index: 45;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: bottom 0.3s var(--ease-out-quart);
  }
  .inno,
  .spotify {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.9rem 0.55rem 0.7rem;
    border: 1px solid var(--oro);
    border-radius: 999px;
    background: color-mix(in oklch, var(--bg) 88%, transparent);
    color: var(--text);
    font-family: var(--font-display);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    cursor: pointer;
    box-shadow: 0 0.4rem 1rem oklch(0 0 0 / 0.4);
  }
  .spotify {
    border-color: #1ed760;
    text-decoration: none;
  }
  .spotify[hidden] {
    display: none;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .spotify svg {
    width: 1.1rem;
    height: 1.1rem;
  }
  .spotify:hover,
  .spotify:focus-visible {
    background: var(--surface);
  }
  .spotify:focus-visible {
    outline: 2px solid #1ed760;
    outline-offset: 2px;
  }
  .inno .invito,
  .inno[data-attesa] .testo,
  .inno .tocco {
    display: none;
  }
  .inno[data-attesa] .invito {
    display: inline;
  }
  @media (pointer: coarse) {
    .inno .clic { display: none; }
    .inno .tocco { display: inline; }
  }
  .inno[data-attesa] {
    animation: inno-pulsa 1.8s var(--ease-out-quart) infinite;
  }
  @keyframes inno-pulsa {
    0% { box-shadow: 0 0.4rem 1rem oklch(0 0 0 / 0.4), 0 0 0 0 color-mix(in oklch, var(--oro) 70%, transparent); }
    70%, 100% { box-shadow: 0 0.4rem 1rem oklch(0 0 0 / 0.4), 0 0 0 0.75rem color-mix(in oklch, var(--oro) 0%, transparent); }
  }
  .inno svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: var(--oro);
  }
  .inno .icona-stop,
  .inno[aria-pressed="true"] .icona-play {
    display: none;
  }
  .inno[aria-pressed="true"] .icona-stop {
    display: block;
  }
  .inno:hover,
  .inno:focus-visible {
    background: var(--surface);
  }
  .inno:focus-visible {
    outline: 2px solid var(--oro);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .inno-barra { transition: none; }
    .inno[data-attesa] { animation: none; }
  }
</style>

<script>
  const audio = document.querySelector<HTMLAudioElement>("[data-inno]");
  const pulsante = document.querySelector<HTMLButtonElement>("[data-inno-pulsante]");
  const spotify = document.querySelector<HTMLAnchorElement>("[data-inno-spotify]");

  if (audio && pulsante) {
    const SCELTA = "inno-scelta"; // "spento" se il visitatore l'ha fermato
    const PUNTO = "inno-punto"; // secondi gia' ascoltati, per riprendere cambiando pagina
    const leggi = (s: Storage, k: string) => { try { return s.getItem(k); } catch { return null; } };
    const scrivi = (s: Storage, k: string, v: string) => { try { s.setItem(k, v); } catch { /* storage bloccato */ } };

    audio.volume = 0.6;
    const punto = Number(leggi(sessionStorage, PUNTO));
    if (punto > 0) audio.addEventListener("loadedmetadata", () => (audio.currentTime = punto), { once: true });

    const aggiorna = () => {
      const suona = !audio.paused;
      if (suona) delete pulsante.dataset.attesa;
      if (spotify) spotify.hidden = !suona;
      pulsante.setAttribute("aria-pressed", String(suona));
      pulsante.setAttribute("aria-label", suona ? "Ferma l'inno del Longi" : "Fai partire l'inno del Longi");
    };
    audio.addEventListener("play", aggiorna);
    audio.addEventListener("pause", aggiorna);

    const EVENTI = ["pointerup", "touchend", "keydown", "click"] as const;
    const smetti = () => EVENTI.forEach((e) => document.removeEventListener(e, alPrimoGesto, true));
    // Se il browser rifiuta (manca ancora un gesto), il pulsante invita al clic.
    const prova = () =>
      audio.play().then(smetti, () => {
        if (audio.paused && leggi(localStorage, SCELTA) !== "spento") pulsante.dataset.attesa = "";
      });
    // Il primo gesto utile fa partire l'inno; il tocco sul pulsante no, perche'
    // lo gestisce il pulsante stesso (altrimenti partirebbe e si fermerebbe).
    function alPrimoGesto(e: Event) {
      if (pulsante!.contains(e.target as Node)) return;
      prova();
    }

    if (leggi(localStorage, SCELTA) !== "spento") {
      EVENTI.forEach((e) => document.addEventListener(e, alPrimoGesto, true));
      prova();
    }

    pulsante.addEventListener("click", () => {
      if (audio.paused) {
        scrivi(localStorage, SCELTA, "acceso");
        prova();
      } else {
        scrivi(localStorage, SCELTA, "spento");
        delete pulsante.dataset.attesa;
        smetti();
        audio.pause();
      }
    });

    // Chi va ad ascoltarlo su Spotify non deve sentirne due insieme.
    spotify?.addEventListener("click", () => audio.pause());

    addEventListener("pagehide", () => {
      scrivi(sessionStorage, PUNTO, audio.paused ? "0" : String(audio.currentTime));
    });
  }
</script>
