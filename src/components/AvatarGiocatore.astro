---
// Faccia del giocatore nella formazione: foto tonda, oppure (finche' la foto
// non c'e') la maglia rossoblu' dimezzata come lo scudo. Il portiere ha il
// bordo oro e la maglia gialla. Numero di maglia in alto a sinistra.
import type { Maglia } from "../lib/formazione";

interface Props {
  maglia: Maglia;
  portiere?: boolean;
}
const { maglia, portiere = false } = Astro.props;
---
<span class:list={["avatar", { portiere }]}>
  {maglia.foto ? (
    <img src={maglia.foto} alt="" loading="lazy" />
  ) : (
    <svg class="maglia" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
      <path class="stoffa" d="M13 3 L8 5 L1 12 L6 18 L9 15.5 V37 H31 V15.5 L34 18 L39 12 L32 5 L27 3 Q20 8 13 3 Z" />
      <path class="meta-dx" d="M20 5.6 Q24 5.2 27 3 L32 5 L39 12 L34 18 L31 15.5 V37 H20 Z" />
      <path class="bordo" d="M13 3 L8 5 L1 12 L6 18 L9 15.5 V37 H31 V15.5 L34 18 L39 12 L32 5 L27 3 Q20 8 13 3 Z" />
    </svg>
  )}
  {maglia.numero !== undefined && <span class="numero">{maglia.numero}</span>}
</span>
<style>
  /* Larghezza e altezza esplicite: con il solo aspect-ratio la foto verticale
     allungava il riquadro e il cerchio diventava un ovale. */
  .avatar {
    position: relative;
    display: block;
    width: var(--avatar, 3.5rem);
    height: var(--avatar, 3.5rem);
    flex-shrink: 0;
    transition: transform 0.2s var(--ease-out-quart);
  }
  .avatar img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 15%;
    border: 2px solid oklch(1 0 0 / 0.9);
    background: var(--surface);
    box-shadow: 0 0.3rem 0.6rem oklch(0 0 0 / 0.35);
  }
  .portiere img {
    border-color: var(--oro);
  }
  .maglia {
    display: block;
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 0.2rem 0.3rem oklch(0 0 0 / 0.35));
  }
  .maglia .stoffa { fill: var(--rosso); }
  .maglia .meta-dx { fill: var(--blu); }
  .maglia .bordo { fill: none; stroke: oklch(1 0 0 / 0.9); stroke-width: 1.2; stroke-linejoin: round; }
  .portiere .maglia .stoffa,
  .portiere .maglia .meta-dx { fill: var(--oro); }
  .numero {
    position: absolute;
    top: -0.2rem;
    left: -0.35rem;
    min-width: 1.4em;
    padding: 0.05em 0.3em;
    border-radius: 0.4em;
    font-family: var(--font-display);
    font-size: 0.75rem;
    line-height: 1.3;
    text-align: center;
    background: var(--bg);
    color: var(--oro);
    border: 1px solid var(--oro);
  }
  @media (prefers-reduced-motion: reduce) {
    .avatar { transition: none; }
  }
</style>
