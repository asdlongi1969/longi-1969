---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"news">;
}
const { post } = Astro.props;
const { title, date, cover, coverAlt } = post.data;
const dateLabel = date.toLocaleDateString("it-IT", { day: "numeric", month: "long", year: "numeric" });
// Stesso nome sulla copertina dell'articolo: nel cambio pagina la foto della
// card si trasforma in quella grande (View Transitions). Il nome deve essere
// un identificatore CSS valido e unico nella pagina: deriva dallo slug.
const nomeTransizione = `news-${post.id.replace(/[^a-zA-Z0-9_-]/g, "-")}`;
---
{/* Card "banda dimezzata": la foto sta sopra, il titolo vive su una banda
    solida tagliata in diagonale rosso/blu come lo scudo. La data e' un
    cartellino d'oro inclinato a cavallo del taglio. Niente titolo in
    sovraimpressione sulla foto (quella e' la voce del sito gemello). */}
<a href={`/news/${post.id}/`} class="news-card" class:list={{ "no-cover": !cover }} data-reveal>
  {cover && (
    <div class="foto-wrap">
      <img src={cover} alt={coverAlt ?? ""} class="cover" loading="lazy" style={`view-transition-name: ${nomeTransizione}`} />
    </div>
  )}
  <div class="banda">
    <span class="cartellino font-display" aria-hidden="true">{dateLabel}</span>
    <p class="visually-hidden">{dateLabel}</p>
    <h3>{title}</h3>
  </div>
</a>
<style>
  .news-card {
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
    transition: transform 0.3s var(--ease-out-quart);
  }
  .news-card:hover,
  .news-card:focus-visible {
    transform: translateY(-2px);
  }
  .foto-wrap {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    /* Il bordo basso della foto scende in diagonale sul lato della banda. */
    clip-path: polygon(0 0, 100% 0, 100% 88%, 0 100%);
  }
  .cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.92);
    transition: filter 0.3s var(--ease-out-quart), transform 0.5s var(--ease-out-quart);
  }
  .news-card:hover .cover,
  .news-card:focus-visible .cover {
    filter: saturate(1.05);
    transform: scale(1.03);
  }
  .banda {
    position: relative;
    flex: 1;
    margin-top: -0.5rem;
    padding: 1.4rem 1.1rem 1.1rem;
    /* Banda dimezzata come lo scudo: rosso a sinistra, blu a destra,
       taglio obliquo. */
    background: linear-gradient(102deg, var(--rosso-fondo) 0 54%, var(--blu) 54% 100%);
  }
  .cartellino {
    position: absolute;
    top: -0.9rem;
    left: 1rem;
    display: inline-block;
    background: var(--oro);
    color: var(--bg);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    padding: 0.28rem 0.7rem;
    transform: skewX(-8deg);
  }
  .news-card h3 {
    color: var(--text);
    font-size: clamp(1.05rem, 2.3vw, 1.45rem);
    margin: 0.35rem 0 0;
    line-height: 1.15;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  /* Senza foto: la banda fa tutta la card, taglio in alto. */
  .no-cover .banda {
    margin-top: 0;
    clip-path: polygon(0 8%, 100% 0, 100% 100%, 0 100%);
    padding-top: 2.2rem;
    min-height: 10rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .no-cover .cartellino {
    top: auto;
    position: static;
    align-self: flex-start;
    margin-bottom: 0.6rem;
  }
  .no-cover h3 {
    font-size: clamp(1.3rem, 3vw, 1.9rem);
  }
  @media (prefers-reduced-motion: reduce) {
    .news-card,
    .cover {
      transition: none;
    }
  }
</style>
