// Cloudflare Workers (build automatica da GitHub a ogni salvataggio dal pannello).
// "name" deve coincidere con il nome del Worker nella dashboard Cloudflare.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "longi-1969",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-29",
  // Il sito vive solo su asdlongi.it (e www): l'indirizzo tecnico *.workers.dev
  // sarebbe un doppione per Google.
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // I link del sito sono senza barra finale (/social): serviti direttamente, senza redirect.
    "html_handling": "drop-trailing-slash",
    // Pagine attraverso il Worker (redirect http -> https, pannello, classifica);
    // i file pesanti no, cosi' non consumano richieste del piano gratuito.
    "run_worker_first": ["/*", "!/_astro/*", "!/img/*", "!/hero-frames/*", "!/audio/*"]
  }
}
